{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100, "title": "System Overview", "type": "row" },

    {
      "id": 1, "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "color": { "mode": "fixed", "fixedColor": "text" }
        }
      },
      "targets": [{ "expr": "node_time_seconds - node_boot_time_seconds", "legendFormat": "Uptime", "refId": "A" }]
    },

    {
      "id": 2, "type": "stat",
      "title": "CPU Cores",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "color": { "mode": "fixed", "fixedColor": "text" }
        }
      },
      "targets": [{ "expr": "count(node_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "Cores", "refId": "A" }]
    },

    {
      "id": 3, "type": "stat",
      "title": "Total Memory",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": { "colorMode": "none", "graphMode": "none", "textMode": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "color": { "mode": "fixed", "fixedColor": "text" }
        }
      },
      "targets": [{ "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total", "refId": "A" }]
    },

    {
      "id": 4, "type": "gauge",
      "title": "CPU Usage",
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1, "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "CPU %", "refId": "A" }]
    },

    {
      "id": 5, "type": "gauge",
      "title": "Memory Usage",
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1, "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "Memory %", "refId": "A" }]
    },

    {
      "id": 6, "type": "gauge",
      "title": "Load Average (1m)",
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto",
        "showThresholdLabels": false, "showThresholdMarkers": true },
      "fieldConfig": {
        "defaults": {
          "unit": "short", "decimals": 2, "min": 0, "max": 8,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 4 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{ "expr": "node_load1", "legendFormat": "Load 1m", "refId": "A" }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 101, "title": "CPU", "type": "row" },

    {
      "id": 10, "type": "timeseries",
      "title": "CPU Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)", "legendFormat": "Total CPU %", "refId": "A" },
        { "expr": "avg(rate(node_cpu_seconds_total{mode=\"system\"}[1m])) * 100", "legendFormat": "System", "refId": "B" },
        { "expr": "avg(rate(node_cpu_seconds_total{mode=\"user\"}[1m])) * 100", "legendFormat": "User", "refId": "C" },
        { "expr": "avg(rate(node_cpu_seconds_total{mode=\"iowait\"}[1m])) * 100", "legendFormat": "I/O Wait", "refId": "D" }
      ]
    },

    {
      "id": 11, "type": "timeseries",
      "title": "Load Average",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "node_load1", "legendFormat": "1m", "refId": "A" },
        { "expr": "node_load5", "legendFormat": "5m", "refId": "B" },
        { "expr": "node_load15", "legendFormat": "15m", "refId": "C" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 102, "title": "Memory", "type": "row" },

    {
      "id": 20, "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "node_memory_MemTotal_bytes", "legendFormat": "Total", "refId": "A" },
        { "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "Used", "refId": "B" },
        { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "Available", "refId": "C" },
        { "expr": "node_memory_Cached_bytes", "legendFormat": "Cached", "refId": "D" }
      ]
    },

    {
      "id": 21, "type": "timeseries",
      "title": "Memory Usage %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "fixedColor": "blue", "mode": "fixed" } } },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "Memory Used %", "refId": "A" }
      ]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "id": 103, "title": "Disk", "type": "row" },

    {
      "id": 30, "type": "timeseries",
      "title": "Disk I/O",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(node_disk_read_bytes_total[1m]))", "legendFormat": "Read", "refId": "A" },
        { "expr": "sum(rate(node_disk_written_bytes_total[1m]))", "legendFormat": "Write", "refId": "B" }
      ]
    },

    {
      "id": 31, "type": "timeseries",
      "title": "Disk I/O Operations",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "iops", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(node_disk_reads_completed_total[1m]))", "legendFormat": "Reads/s", "refId": "A" },
        { "expr": "sum(rate(node_disk_writes_completed_total[1m]))", "legendFormat": "Writes/s", "refId": "B" }
      ]
    },

    {
      "id": 32, "type": "bargauge",
      "title": "Filesystem Usage %",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "options": {
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "displayMode": "gradient",
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] },
          "color": { "mode": "thresholds" }
        }
      },
      "targets": [{
        "expr": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"}) * 100",
        "legendFormat": "{{mountpoint}}", "refId": "A"
      }]
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 },
      "id": 104, "title": "Network", "type": "row" },

    {
      "id": 40, "type": "timeseries",
      "title": "Network Traffic",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total{device!~\"lo|docker.*|br-.*\"}[1m]))", "legendFormat": "Received", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|br-.*\"}[1m]))", "legendFormat": "Transmitted", "refId": "B" }
      ]
    },

    {
      "id": 41, "type": "timeseries",
      "title": "Network Packets",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "pps", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(node_network_receive_packets_total{device!~\"lo|docker.*|br-.*\"}[1m]))", "legendFormat": "Received pkts/s", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_packets_total{device!~\"lo|docker.*|br-.*\"}[1m]))", "legendFormat": "Transmitted pkts/s", "refId": "B" }
      ]
    },

    {
      "id": 42, "type": "timeseries",
      "title": "Network Errors & Drops",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 49 },
      "datasource": { "type": "prometheus", "uid": "fg45hkw820934b" },
      "fieldConfig": { "defaults": { "unit": "pps", "color": { "mode": "palette-classic" } } },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "expr": "sum(rate(node_network_receive_errs_total{device!~\"lo\"}[1m]))", "legendFormat": "Receive Errors", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_errs_total{device!~\"lo\"}[1m]))", "legendFormat": "Transmit Errors", "refId": "B" },
        { "expr": "sum(rate(node_network_receive_drop_total{device!~\"lo\"}[1m]))", "legendFormat": "Receive Drops", "refId": "C" }
      ]
    }

  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["linux", "system", "infrastructure"],
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Linux Machine",
  "uid": "linux-machine",
  "version": 1
